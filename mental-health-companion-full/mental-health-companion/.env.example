# ---------- General ----------
APP_NAME=Mental Health Companion
ENVIRONMENT=development            # development | production
DEBUG=true
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ---------- Database ----------
POSTGRES_USER=mhc
POSTGRES_PASSWORD=change_me_db_password
POSTGRES_DB=mhc
DATABASE_URL=postgresql+psycopg://mhc:change_me_db_password@db:5432/mhc

# ---------- Redis (cache, rate limit store, Celery broker) ----------
REDIS_URL=redis://redis:6379/0

# ---------- Auth / JWT ----------
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change_me_jwt_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
SESSION_IDLE_TIMEOUT_MINUTES=30
MAX_FAILED_LOGINS=5
ACCOUNT_LOCK_MINUTES=15

# ---------- Encryption at rest (AES-256-GCM) ----------
# MUST be 32 random bytes, base64 encoded.
# Generate: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
DATA_ENCRYPTION_KEY=change_me_base64_32_bytes

# ---------- Email / SMS (placeholders; console provider logs instead of sending) ----------
EMAIL_PROVIDER=console             # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@mhc.local
SMS_PROVIDER=console               # console | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- ML ----------
ML_MODELS_DIR=/app/ml/saved_models
ACTIVE_MODEL_FALLBACK=tfidf_lr
TRANSFORMER_LAZY_LOAD=true

# ---------- Seed ----------
SEED_ON_START=false
SEED_DEMO_PASSWORD=Demo@12345      # demo accounts only; never use in production
